# Required. At least 16 chars, but use 32+ random bytes: openssl rand -hex 32. Changing it signs everyone out.
SESSION_SECRET=
# How many proxies sit in front of the app (Cloudflare + Apache = 2). Used to find the real client address for rate limiting.
# TRUSTED_PROXY_HOPS=2
# Optional. Enables AI grading of open / scenario answers.
ANTHROPIC_API_KEY=

# Optional. Lets gglearn email invitations itself (through Resend, as ggsocial does). Both are needed; without them nothing is sent and managers copy each
# invitation link or use "Open in email". MAIL_FROM must be on a domain you have verified in Resend, e.g. "gglearn <gglearn@your-domain>".
RESEND_API_KEY=
MAIL_FROM=

# Public address of the site, used for absolute links in share cards (no trailing slash). If unset, the request's own host is used.
SITE_URL=

# Personal sign-in with Google and Microsoft (optional; nothing shows until set). Redirect URIs: <SITE_URL>/auth/google/callback and <SITE_URL>/auth/microsoft/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
