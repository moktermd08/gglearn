# Required. At least 16 chars, but use 32+ random bytes: openssl rand -hex 32. Changing it signs everyone out.
SESSION_SECRET=
# How many proxies sit in front of the app (Cloudflare + Apache = 2). Used to find the real client address for rate limiting.
# TRUSTED_PROXY_HOPS=2
# Optional. Enables AI grading of open / scenario answers.
ANTHROPIC_API_KEY=
